{
  "name": "byeongithon-opus-stats",
  "version": "0.1.0",
  "description": "🚽 변기톤-오푸스 통계 · 노마다마스 해커하우스 동안 사용된 Claude Opus 4.7 토큰 대시보드",
  "type": "module",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/code-yeongyu/byeongithon-opus-stats",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-yeongyu/byeongithon-opus-stats.git"
  },
  "keywords": [
    "byeongithon",
    "변기톤",
    "nomadamas",
    "노마다마스",
    "claude",
    "opus",
    "opus-4-7",
    "cloudflare-workers",
    "r2",
    "typescript",
    "dashboard",
    "analytics",
    "oh-my-openagent"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy --env production",
    "deploy:assets": "bash scripts/upload-to-r2.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:loc": "bash scripts/check-loc-limit.sh",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:loc"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/workers-types": "^5.20260919.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "chrome-launcher": "^1.2.1",
    "happy-dom": "^20.14.5",
    "lighthouse": "^13.5.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0",
    "zod": "^4.6.5"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
