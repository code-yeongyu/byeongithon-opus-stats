{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error"
			},
			"complexity": {
				"useLiteralKeys": "off"
			},
			"style": {
				"noNonNullAssertion": "error",
				"useImportType": "error",
				"useConst": "error",
				"noDefaultExport": "off"
			},
			"suspicious": {
				"noExplicitAny": "error"
			}
		}
	},
	"files": {
		"include": [
			"src/**/*.ts",
			"src/**/*.tsx",
			"test/**/*.ts",
			"vitest.config.ts",
			"vite.config.ts"
		],
		"ignore": [
			"node_modules",
			"dist",
			"coverage",
			".wrangler",
			"public/data"
		]
	}
}
